{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "appstublibrary Index",
  "description": "仓库索引文件格式定义",
  "type": "object",
  "required": ["version", "repos"],
  "properties": {
    "version": {
      "type": "string",
      "description": "索引格式版本"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "最后更新时间"
    },
    "repos": {
      "type": "array",
      "description": "仓库列表",
      "items": {
        "type": "object",
        "required": ["id", "name", "latest", "tags"],
        "properties": {
          "id": {
            "type": "string",
            "description": "仓库唯一标识，对应 stubs/{id}/ 目录"
          },
          "name": {
            "type": "string",
            "description": "仓库显示名称（可重复）"
          },
          "description": {
            "type": "string",
            "description": "仓库描述"
          },
          "latest": {
            "type": "string",
            "description": "最新版本号"
          },
          "tags": {
            "type": "array",
            "description": "版本列表，每个版本包含版本号和路径映射",
            "items": {
              "type": "object",
              "required": ["version", "mappings"],
              "properties": {
                "version": {
                  "type": "string",
                  "description": "版本号，对应 tags/{version}/ 目录"
                },
                "mappings": {
                  "type": "object",
                  "description": "路径映射，key 是 tags/{version}/ 下的文件夹名，value 是目标项目中的安装路径",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "maintainers": {
            "type": "array",
            "description": "维护者列表",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "用户名"
                },
                {
                  "type": "object",
                  "required": ["type", "name"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["user", "group"],
                      "description": "维护者类型"
                    },
                    "name": {
                      "type": "string",
                      "description": "用户名或组名"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
